{
	"manifest_version": 2.0,
	"id": "raa_monitor",
	"type": "widget",
	"name": "RAA Monitor",
	"namespace": "RaaMonitor",
	"version": "1.0",
	"author": "daig0rian",
	"description": "Listen to Remote Audio Aggregation server audio directly in your Zabbix dashboard — no SIP client required.",
	"url": "https://github.com/daig0rian/remote-audio-aggregation",
	"widget": {
		"name": "RAA Monitor",
		"size": {
			"width": 12,
			"height": 2
		},
		"js_class": "CWidgetRaaMonitor",
		"refresh_rate": 0
	},
	"actions": {
		"widget.raa_monitor.view": {
			"class": "WidgetView"
		}
	},
	"assets": {
		"js": [
			"opus-decoder.bundle.js",
			"raa-player.js",
			"class.widget.js"
		],
		"css": [
			"widget.css"
		]
	}
}
