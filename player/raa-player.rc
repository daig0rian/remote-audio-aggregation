// raa-player.rc
// Keep this file ASCII-only: localized captions are set at runtime from the string tables
// in raa-player.cpp.
#include "resource.h"
#include <windows.h>

// Application icon (used by Explorer and window title bar)
IDI_APP           ICON "icons\\playing.ico"

// Tray state icons
IDI_TRAY_PLAYING  ICON "icons\\playing.ico"
IDI_TRAY_IDLE     ICON "icons\\idle.ico"
IDI_TRAY_STOPPED  ICON "icons\\stopped.ico"
IDI_TRAY_OFFLINE  ICON "icons\\offline.ico"

IDD_SETTINGS DIALOGEX 0, 0, 230, 126
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "RAA Player"
FONT 9, "MS Shell Dlg 2"
BEGIN
    LTEXT           "", IDC_LBL_HOST,          7,   8, 216,  9
    EDITTEXT        IDC_HOST,                  7,  19, 216, 13, ES_AUTOHSCROLL

    LTEXT           "", IDC_LBL_PORT,          7,  40,  60,  9
    EDITTEXT        IDC_PORT,                  7,  51,  50, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_LBL_BUFFER,       75,  40, 100,  9
    EDITTEXT        IDC_BUFFER,               75,  51,  50, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_LBL_BUFFER_NOTE,   7,  69, 216, 18

    AUTOCHECKBOX    "", IDC_AUTOSTART,         7,  91, 216, 10

    DEFPUSHBUTTON   "OK", IDOK,              119, 106,  50, 14
    PUSHBUTTON      "Cancel", IDCANCEL,      173, 106,  50, 14
END
