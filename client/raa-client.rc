// raa-client.rc
#include "resource.h"
#include <windows.h>

// Application icon (used by Explorer and window title bar)
IDI_APP    ICON "icons\\active.ico"

// Tray state icons
IDI_TRAY_ACTIVE ICON "icons\\active.ico"
IDI_TRAY_SILENT ICON "icons\\silent.ico"
IDI_TRAY_ERROR  ICON "icons\\error.ico"

// ---------- 接続 page ----------
IDD_PAGE_CONNECTION DIALOGEX 0, 0, 220, 160
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 9, "MS UI Gothic"
BEGIN
    LTEXT           "Server IP:", -1,               7,  10, 60, 9
    EDITTEXT        IDC_SERVER_IP,                  7,  21, 120, 13, ES_AUTOHSCROLL
    LTEXT           "Port:", -1,                  133, 10, 30,  9
    EDITTEXT        IDC_SERVER_PORT,              133,  21, 40, 13, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "Client ID (SSRC):", -1,        7,  48, 90, 9
    LTEXT           "",  IDC_SSRC_DISPLAY,           7,  60, 120, 10
END

// ---------- Audio page ----------
IDD_PAGE_AUDIO DIALOGEX 0, 0, 220, 160
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 9, "MS UI Gothic"
BEGIN
    GROUPBOX        "Opus Encoder", -1,              7,   7, 200, 40
    LTEXT           "Bitrate (kbps):", -1,          14,  22, 70, 9
    EDITTEXT        IDC_BITRATE,                    90,  20, 40, 13, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_BITRATE_SPIN, "msctls_updown32", 0x50000026, 130, 20, 11, 13

    GROUPBOX        "Capture API", -1,               7,  55, 200, 82
    AUTORADIOBUTTON "", IDC_LOOPBACK_PROCESS,        14,  69, 186, 10, WS_GROUP
    AUTORADIOBUTTON "", IDC_LOOPBACK_CLASSIC,        14,  83, 186, 10
    LTEXT           "", IDC_LOOPBACK_NOTE,           14,  97, 186, 16
END

// ---------- Detection page ----------
IDD_PAGE_DETECTION DIALOGEX 0, 0, 220, 160
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 9, "MS UI Gothic"
BEGIN
    GROUPBOX        "DTX Settings", -1,              7,   7, 200, 80

    LTEXT           "Silence guard (ms):", -1,       14,  24, 95, 9
    EDITTEXT        IDC_SILENCE_GUARD,              111,  22, 50, 13, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_SILENCE_GUARD_SPIN, "msctls_updown32", 0x50000026, 161, 22, 11, 13

    LTEXT           "Audio guard (ms):", -1,         14,  44, 95, 9
    EDITTEXT        IDC_AUDIO_GUARD,                111,  42, 50, 13, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_AUDIO_GUARD_SPIN, "msctls_updown32", 0x50000026, 161, 42, 11, 13
END

// ---------- Notify page (batch file / SNMP trap) ----------
// Labels are set at runtime (page_notify). Batch and SNMP controls share the area below
// the radio buttons; only the set for the selected method is shown.
IDD_PAGE_NOTIFY DIALOGEX 0, 0, 262, 196
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 9, "MS UI Gothic"
BEGIN
    LTEXT           "Method:", IDC_NOTIFY_LABEL,       7,   9,  50,  9
    AUTORADIOBUTTON "Batch file", IDC_NOTIFY_BATCH,   60,   8,  90, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "SNMP trap", IDC_NOTIFY_SNMP,    155,   8, 100, 10

    // Batch mode
    GROUPBOX        "On audio start", IDC_BATCH_START_GROUP, 7, 26, 248, 34, WS_GROUP
    EDITTEXT        IDC_BATCH_START,                  13,  39, 210, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BATCH_START_BROWSE,   226,  39,  24, 13
    GROUPBOX        "On audio stop", IDC_BATCH_STOP_GROUP,   7, 66, 248, 34
    EDITTEXT        IDC_BATCH_STOP,                   13,  79, 210, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BATCH_STOP_BROWSE,    226,  79,  24, 13
    LTEXT           "Timeout (ms):", IDC_BATCH_TIMEOUT_LABEL, 7, 110, 70, 9
    EDITTEXT        IDC_BATCH_TIMEOUT,                80, 108,  50, 13, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_BATCH_TIMEOUT_SPIN, "msctls_updown32", 0x50000026, 130, 108, 11, 13
    LTEXT           "", IDC_BATCH_NOTE,                7, 126, 248, 18

    // SNMP trap mode
    LTEXT           "On audio start:", IDC_SNMP_START_LABEL, 7, 28, 180, 9
    PUSHBUTTON      "Send test", IDC_SNMP_TEST_START, 195,  25,  60, 13
    EDITTEXT        IDC_SNMP_START,                    7,  40, 248, 50, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "On audio stop:", IDC_SNMP_STOP_LABEL,   7, 96, 180, 9
    PUSHBUTTON      "Send test", IDC_SNMP_TEST_STOP,  195,  93,  60, 13
    EDITTEXT        IDC_SNMP_STOP,                     7, 108, 248, 50, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Charset:", IDC_SNMP_CHARSET_LABEL, 7, 166, 50, 9
    COMBOBOX        IDC_SNMP_CHARSET,                 60, 164,  90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_SNMP_HINT,                 7, 180, 248, 16
END

// ---------- General page ----------
IDD_PAGE_GENERAL DIALOGEX 0, 0, 220, 160
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 9, "MS UI Gothic"
BEGIN
    AUTOCHECKBOX    "Start with Windows", IDC_AUTOSTART, 7, 14, 130, 10
END
