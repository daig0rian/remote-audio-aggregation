# systemd USER service for raa-server
# This file is a reference template. install.sh generates the actual service
# file at ~/.config/systemd/user/raa-server.service with correct absolute paths.
#
# To install manually:
#   1. Copy to ~/.config/systemd/user/raa-server.service
#   2. Replace ${HOME} and ${NODE_BIN} with actual paths
#   3. systemctl --user daemon-reload && systemctl --user enable --now raa-server
#   4. sudo loginctl enable-linger $USER   # boot startup without login

[Unit]
Description=Remote Audio Aggregation Server
After=network.target

[Service]
ExecStart=${NODE_BIN} ${HOME}/raa-server/src/main.js
WorkingDirectory=${HOME}/raa-server
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info
StandardOutput=journal
StandardError=journal
SyslogIdentifier=raa-server

[Install]
WantedBy=default.target
